<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net462;net48;net8.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<!-- C# 9+ is required by the System.Text.Json source generator on every target framework. -->
		<LangVersion>latest</LangVersion>
		<Version>6.5.0</Version>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Description>A simple C# async TCP server and client with integrated framing for reliable transmission and receipt of data</Description>
		<Copyright>(c)2025 Joel Christner</Copyright>
		<PackageTags>tcp rpc ssl aot message messaging frame framing async api server bus queue mesh fabric</PackageTags>
		<PackageProjectUrl>https://github.com/dotnet/WatsonTcp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/dotnet/WatsonTcp</RepositoryUrl>
		<RepositoryType>Github</RepositoryType>
		<PackageLicenseUrl></PackageLicenseUrl>
		<PackageReleaseNotes>Native AOT and trimming compatibility: source-generated JSON for all wire types and common metadata values, IsAotCompatible on net8.0+, optional caller-supplied IJsonTypeInfoResolver for custom metadata types. See CHANGELOG.md.</PackageReleaseNotes>
		<PackageIconUrl></PackageIconUrl>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>watson.png</PackageIcon>
		<DocumentationFile>WatsonTcp.xml</DocumentationFile>
		<Title>WatsonTcp</Title>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!--
		Native AOT and trimming.  IsAotCompatible enables the trim, AOT, and single-file analyzers and marks the
		assembly as trimmable; it applies only to target frameworks that support Native AOT.  Any trim or AOT
		analyzer warning fails the build so that compatibility cannot silently regress.
	-->
	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<IsAotCompatible>true</IsAotCompatible>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2058;IL2059;IL2060;IL2062;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2104;IL2111;IL3050;IL3051;IL3053;SYSLIB1034;SYSLIB1037;SYSLIB1038</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="assets\watson.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="LICENSE.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<!--
		System.Text.Json is in-box on net8.0 and net10.0.  Referencing the out-of-band package there would replace the
		in-box, AOT-validated assembly with one whose net8.0 build emits trim warnings under the .NET 8 ILC.
	-->
	<ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<PackageReference Include="System.Text.Json" Version="9.0.10" />
	</ItemGroup>

	<!--
		System.Diagnostics.Metrics (Meter/Counter/Histogram/ObservableGauge/TagList) and
		System.Diagnostics.ActivitySource are in-box on net8.0 and net10.0 but ship via the
		System.Diagnostics.DiagnosticSource package for the down-level target frameworks.
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1' Or '$(TargetFramework)' == 'net462' Or '$(TargetFramework)' == 'net48'">
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="assets\watson.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="assets\watson.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="WatsonTcp.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
